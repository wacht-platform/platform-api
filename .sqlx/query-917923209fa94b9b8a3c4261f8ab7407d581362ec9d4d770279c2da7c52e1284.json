  "query": "\n            SELECT\n                id,\n                deployment_id,\n                actor_id,\n                project_id,\n                thread_id,\n                execution_run_id,\n                owner_agent_id,\n                recorded_by_agent_id,\n                memory_scope,\n                content,\n                embedding as \"embedding: Vector\",\n                memory_category,\n                metadata,\n                created_at,\n                updated_at,\n                NULL::double precision as distance\n            FROM agent_memories\n            WHERE deployment_id = $1 AND id = $2\n            FOR UPDATE\n            LIMIT 1\n            ",
